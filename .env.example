# Your HTTPS address. App logins (Google, Meta, TikTok) send people back here.
PUBLIC_URL=https://cast.example.com

# Long random text. Locks the saved tokens and stream keys. Keep it safe; changing it
# makes saved logins unreadable. Make one with:  openssl rand -hex 32
AUTOCAST_SECRET=change-me

# Server clock for schedules and post times.
TZ=Asia/Jakarta

# Posts sent at the same time (1-4 is fine for a small VPS).
UPLOAD_PARALLEL=2
